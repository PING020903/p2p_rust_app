# 默认忽略一切，仅白名单放行需要上传的内容
/*

# 白名单
!/.gitignore
!/README.md
!/CHANGELOG.md
!/LICENSE
!/Cargo.toml
!/Cargo.lock
!/.cargo/
!/source/
!/tests/
# 真实测试凭据不入库：从 tests/users.template.txt 复制创建
/tests/users.txt
!/.opencode/
!/docs/
!/wish/
!/xtask/
# xtask 构建产物不入库（保留源码）
/xtask/target/
!/assets/
# assets 只入库字体资源（无需忽略子内容）

# .opencode 下保留 skills 与 agent
/.opencode/*
!/.opencode/skills/
!/.opencode/agent/
