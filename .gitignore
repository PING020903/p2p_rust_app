# 默认忽略一切，仅白名单放行需要上传的内容
/*

# 白名单
!/.gitignore
!/README.md
!/CHANGELOG.md
!/LICENSE
!/Cargo.toml
!/Cargo.lock
!/.cargo/
!/source/
!/tests/
# 真实测试凭据不入库：从 tests/users.template.txt 复制创建
/tests/users.txt
!/.opencode/
!/docs/
!/wish/

# .opencode 下保留 skills 与 agent
/.opencode/*
!/.opencode/skills/
!/.opencode/agent/
